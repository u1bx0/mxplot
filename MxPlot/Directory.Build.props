<Project>

	<!-- Common properties for MxPlot projects -->

	<PropertyGroup>
		<Version>0.7.0</Version>
		<PackageVersion>0.7.0</PackageVersion>
		<Authors>u1bx0</Authors>
		<Description>MxPlot: Multi-Axis Matrix Visualization Library for .NET. This project is currently under active development.</Description>

		<Copyright>Copyright (c) 2026 u1bx0</Copyright>

		<PackageTags>plot;chart;graph;visualization;matrix;heatmap;multi-axis;dotnet;imaging;hyperstack</PackageTags>
		
		<PackageProjectUrl>https://github.com/u1bx0/mxplot</PackageProjectUrl>
		<RepositoryUrl>https://github.com/u1bx0/mxplot</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1591</NoWarn>

	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- $(MSBuildThisFileDirectory)  refers to the location based on the directly of this file; (MxPlot_Root\MxPlot\)-->
		<!-- $(SolutionDir) should not be used because it may be undefined during nuget restore or other non‑Visual Studio builds, causing LocalPackages to be created in the project directory. -->
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\LocalPackages\</PackageOutputPath>
	</PropertyGroup>

	<!-- "Autogenerated": BenchmarkDotNet's own generated toolchain project (e.g.
	     Tests.Benchmarks\bin\...\Tests.Benchmarks-DefaultJob-1\BenchmarkDotNet.Autogenerated.csproj),
	     built fresh on every benchmark run. It lives deep enough under a Test* project's own bin
	     folder that MSBuild still picks up this Directory.Build.props, but its own directory has
	     no README.md, so the packaging settings above make `dotnet run` on any benchmark fail with
	     NU5019 (missing README.md) unless it is excluded here too. -->
	<PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Test')) OR $(MSBuildProjectName.Contains('Autogenerated'))">
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>